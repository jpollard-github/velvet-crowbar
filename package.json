{
  "name": "velvet-crowbar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Calm language for difficult systems.",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx scripts/db-seed.ts",
    "admin:bootstrap": "node --import tsx scripts/admin-bootstrap.ts",
    "admin:reset-password": "node --import tsx scripts/admin-reset-password.ts",
    "audit:docs": "node --import tsx scripts/audit-docs.ts",
    "audit:structure": "node --import tsx scripts/audit-structure.ts",
    "audit:unused": "node --import tsx scripts/audit-unused.ts",
    "audit:deps": "pnpm audit --prod",
    "verify:full": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm audit:docs && pnpm audit:structure && pnpm audit:unused && pnpm build && pnpm test:e2e",
    "repo:export:dry-run": "node --import tsx scripts/repo-export.ts --dry-run",
    "repo:export": "node --import tsx scripts/repo-export.ts"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
